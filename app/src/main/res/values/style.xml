<?xml version="1.0" encoding="utf-8"?>
<resources>





<!--    セクションのタイトル-->
    <style name="SectionTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginBottom">16dp</item>

        <item name="android:paddingStart">8dp</item>
        <item name="android:background">@drawable/bg_section_title</item>
    </style>

    <style name="SectionTitle2">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>


<!--    セクションのサブタイトル-->
    <style name="SubTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>

        <item name="android:layout_marginBottom">8dp</item>
    </style>


<!--    本文の文字-->
    <style name="BodyTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>

        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="BodyTitleNoMargin">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>

    </style>

    <style name="Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>

        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="BodyNoMargin">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>

    </style>

    <style name="Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>

        <item name="android:layout_marginBottom">8dp</item>

    </style>

<!--    リンクつき文字-->
    <style name="LinkText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_link</item>

        <item name="android:layout_marginBottom">8dp</item>
    </style>
<!--    白文字-->
    <style name="BodyWhite">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>

        <item name="android:layout_marginBottom">8dp</item>
    </style>


<!--    ボタン-->
    <style name="Button.positive" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_selector</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Button.neutral" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_neutral</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Button.negative" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_negative</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Button.delete" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/button_delete</item>
        <item name="android:textColor">@color/button_delete</item>

    </style>


<!--    能力値の装飾-->
    <style name="StatItemContainer">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginEnd">18dp</item>
    </style>

    <style name="StatLabel">

        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#666666</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>



</resources>