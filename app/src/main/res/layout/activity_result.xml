<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<!--    全体のビュー-->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <!--    タイトル-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SectionTitle"
            android:text="診断結果"
            />

        <!--    共有ボタン-->
        <ImageView
            android:id="@+id/ivShareResult"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_share"
            android:layout_marginStart="16dp"
            />


    </LinearLayout>


<!--レーダーチャート-->
    <com.github.mikephil.charting.charts.RadarChart
        android:id="@id/radarChart"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="12dp"
        />


<!--導入テキスト-->
    <TextView
        android:id="@+id/tvIntroText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="診断完了。\nあなたの内面に眠る5つの性格のレベルが検出されました。\nそれぞれの性格に応じた「パーソナルモンスター」を召喚しましょう。"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        />




<!--    外向性-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/social_color"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvETitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="外向性：★★★"
                android:textColor="#F5F5F5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                />

            <LinearLayout
                android:id="@+id/rootSubTraitE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!--            下位特性①-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/BodyWhite"
                        android:text=" 社交性："/>
                    <TextView
                        android:id="@+id/tvESubTrait1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/BodyWhite"
                        android:layout_marginStart="20dp"
                        android:text="1.9 / 5"
                        />
                </LinearLayout>

                <!--            下位特性②-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/BodyWhite"
                        android:text=" リーダーシップ："/>

                    <TextView
                        android:id="@+id/tvESubTrait2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/BodyWhite"
                        android:layout_marginStart="20dp"
                        android:text="/ 5"
                        />
                </LinearLayout>

                <!--            下位特性③-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/BodyWhite"
                        android:text=" 活発さ："/>
                    <TextView
                        android:id="@+id/tvESubTrait3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/BodyWhite"
                        android:layout_marginStart="20dp"
                        android:text="/ 5"
                        />
                </LinearLayout>
            </LinearLayout>


